<% content_for :title, @list.name %>

<div class="mb-6">
  <%= link_to lists_path, class: "inline-flex items-center gap-1 text-sm text-stone-600 hover:text-stone-900" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
    Lists
  <% end %>
</div>

<div class="flex items-start justify-between gap-4 mb-2">
  <div>
    <h1 class="text-3xl font-semibold tracking-tight"><%= @list.name %></h1>
    <% if @list.user_id != current_user&.id %>
      <p class="text-xs text-stone-500 mt-1">Shared by <%= @list.user.display_name %></p>
    <% end %>
  </div>

  <% if current_user&.can_edit_list?(@list) %>
    <div class="shrink-0 flex items-center gap-2">
      <%= link_to "Re-import", reimport_list_path(@list),
            class: "inline-flex items-center px-3 py-1.5 bg-white border border-stone-300 text-stone-700 text-sm font-medium rounded-md hover:bg-stone-50 transition" %>
      <%= link_to "Edit", edit_list_path(@list),
            class: "inline-flex items-center px-3 py-1.5 bg-white border border-stone-300 text-stone-700 text-sm font-medium rounded-md hover:bg-stone-50 transition" %>
      <%= button_to @list,
            method: :delete,
            form: { data: { turbo_confirm: "Delete '#{@list.name}' and all its entries?" } },
            class: "inline-flex items-center px-3 py-1.5 bg-white border border-stone-300 text-stone-700 text-sm font-medium rounded-md hover:bg-red-50 hover:border-red-200 hover:text-red-700 transition cursor-pointer" do %>
        Delete
      <% end %>
    </div>
  <% end %>
</div>

<p class="text-sm text-stone-600 mb-1">
  <span class="font-mono text-stone-900"><%= @list.matched_count %></span>
  of
  <span class="font-mono text-stone-900"><%= @list.total_count %></span>
  in your library
</p>

<% if (source = @list.safe_source_url) %>
  <p class="text-xs text-stone-500 mb-6">
    Source:
    <%= link_to source, source, target: "_blank", rel: "noopener",
          class: "underline hover:text-stone-900 break-all" %>
  </p>
<% end %>

<% if @list.description.present? %>
  <p class="text-sm text-stone-700 mb-6 max-w-2xl"><%= @list.description %></p>
<% end %>

<div class="border-t border-stone-200 pt-4 mt-4">
  <ol class="space-y-1">
    <% @entries.each_with_index do |entry, index| %>
      <li class="group flex items-center gap-3 px-3 py-2 rounded-md <%= entry.matched? ? "bg-emerald-50/40" : "" %>">
        <span class="shrink-0 w-6 text-right text-xs text-stone-400 font-mono"><%= index + 1 %></span>

        <div class="w-8 h-12 shrink-0 bg-stone-100 rounded overflow-hidden ring-1 ring-stone-200/60">
          <% if entry.matched? && entry.book.assets.cover_available? %>
            <%= image_tag cover_book_path(entry.book, v: entry.book.updated_at.to_i), alt: "", loading: "lazy", class: "w-full h-full object-cover" %>
          <% elsif entry.cover_url.present? %>
            <img src="<%= entry.cover_url %>" alt="" loading="lazy" referrerpolicy="no-referrer" class="w-full h-full object-cover">
          <% end %>
        </div>

        <div class="flex-1 min-w-0">
          <% if entry.matched? %>
            <%= link_to entry.book, class: "block group/link" do %>
              <p class="text-sm font-medium text-stone-900 group-hover/link:text-amber-700 truncate"><%= entry.book.title %></p>
              <% if entry.book.authors.any? %>
                <p class="text-xs text-stone-500 truncate"><%= entry.book.author_names %></p>
              <% end %>
            <% end %>
          <% else %>
            <p class="text-sm text-stone-700 truncate"><%= entry.display_title %></p>
            <% if entry.display_author.present? || entry.release_year %>
              <p class="text-xs text-stone-500 truncate">
                <%= entry.display_author %><%= " · #{entry.release_year}" if entry.release_year %>
              </p>
            <% end %>
          <% end %>

          <% if entry.ambiguous? && current_user&.can_edit_list?(@list) %>
            <div class="mt-1.5 flex flex-wrap items-center gap-1.5 text-xs">
              <span class="text-stone-500">Which one?</span>
              <% entry.candidates.each do |candidate| %>
                <%= button_to choose_list_list_entry_path(@list, entry),
                      method: :patch,
                      params: { hardcover_book_id: candidate.id },
                      class: "inline-flex items-center px-2 py-0.5 rounded border border-stone-300 bg-white text-stone-700 hover:border-amber-600 hover:text-amber-800 cursor-pointer" do %>
                  <%= candidate.title %><%= " — #{candidate.author}" if candidate.author %><%= " (#{candidate.release_year})" if candidate.release_year %>
                <% end %>
              <% end %>
              <%= button_to "None of these", choose_list_list_entry_path(@list, entry),
                    method: :patch,
                    class: "px-2 py-0.5 text-stone-500 hover:text-stone-800 cursor-pointer" %>
            </div>
          <% end %>
        </div>

        <% if entry.matched? %>
          <span class="shrink-0 inline-flex items-center gap-1 text-xs text-emerald-700 font-medium">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
            In library
          </span>
        <% else %>
          <% if (shelfmark = shelfmark_search_url(title: entry.display_title, author: entry.display_author)) %>
            <%= link_to shelfmark, target: "_blank", rel: "noopener",
                  class: "shrink-0 inline-flex items-center gap-1 text-xs text-amber-700 hover:text-amber-900 font-medium" do %>
              Find on Shelfmark
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            <% end %>
          <% end %>
          <span class="shrink-0 text-xs text-stone-400">
            Not in library
          </span>
        <% end %>

        <% if current_user&.can_edit_list?(@list) %>
          <%= button_to list_list_entry_path(@list, entry),
                method: :delete,
                form: { data: { turbo_confirm: "Remove '#{entry.title}' from this list?" } },
                title: "Remove entry",
                class: "shrink-0 opacity-0 group-hover:opacity-100 transition-opacity text-stone-400 hover:text-red-700 cursor-pointer" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ol>

  <% if current_user&.can_edit_list?(@list) %>
    <div class="mt-4 pt-4 border-t border-stone-100">
      <div class="relative"
           data-controller="search-dropdown"
           data-search-dropdown-url-value="<%= search_list_list_entries_path(@list) %>">
        <%= form_with url: list_list_entries_path(@list), method: :post, local: true do %>
          <%= text_field_tag "list_entry[query]", nil,
                placeholder: "Add a book: search by title or author",
                required: true,
                autocomplete: "off",
                data: { search_dropdown_target: "input", action: "input->search-dropdown#query focus->search-dropdown#focus keydown->search-dropdown#keydown" },
                class: "w-full rounded-md border border-stone-300 px-3 py-2 text-sm shadow-sm focus:border-amber-600 focus:ring-amber-600 focus:outline-none" %>
        <% end %>
        <%# Kept outside the form above: each result is its own button_to form. %>
        <div data-search-dropdown-target="dropdown"
             hidden
             class="absolute top-full left-0 right-0 mt-1 bg-white border border-stone-200 rounded-md shadow-lg z-50 max-h-96 overflow-y-auto">
          <turbo-frame id="list-entry-search-results" data-search-dropdown-target="frame"></turbo-frame>
        </div>
      </div>
      <p class="mt-1 text-xs text-stone-500">Pick a result, or press Enter to add it as typed (&ldquo;Title by Author&rdquo; works).</p>
    </div>
  <% end %>
</div>
